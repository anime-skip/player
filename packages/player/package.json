{
  "name": "@anime-skip/player",
  "version": "1.0.0",
  "description": "Video player integrated with Anime Skip",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "compile": "vue-tsc --noEmit",
    "test": "vitest",
    "generate:graphql": "graphql-codegen --config graphql-codegen.yml",
    "prepare": "pnpm build"
  },
  "devDependencies": {
    "@graphql-codegen/add": "^4.0.1",
    "@graphql-codegen/cli": "^3.3.1",
    "@graphql-codegen/typescript": "^3.0.4",
    "@graphql-codegen/typescript-graphql-request": "^4.5.9",
    "@graphql-codegen/typescript-operations": "^3.0.4",
    "@iconify/json": "^2.2.472",
    "@types/chance": "^1.1.8",
    "@types/md5": "^2.3.6",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "autoprefixer": "^10.5.0",
    "chance": "^1.1.13",
    "daisyui": "^2.52.0",
    "postcss": "^8.5.14",
    "postcss-unroot": "^1.0.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.0.12",
    "vite-plugin-css-injected-by-js": "^5.0.1",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.1.6",
    "vue-tsc": "^3.2.8"
  },
  "dependencies": {
    "@vueuse/core": "^14.3.0",
    "fuzzysort": "^3.1.0",
    "graphql": "^16.14.0",
    "graphql-request": "~5.1.0",
    "graphql-tag": "^2.12.6",
    "md5": "^2.3.0",
    "p-singleton": "^1.0.4",
    "uuid": "^14.0.0",
    "vue": "^3.5.34",
    "vue-query": "^1.26.0"
  }
}
