{
  "name": "@anime-skip/extension",
  "version": "2.0.6",
  "type": "module",
  "scripts": {
    "check": "buildc --deps-only -- check",
    "dev": "buildc --deps-only -- wxt",
    "dev:firefox": "buildc --deps-only -- pnpm -s dev -b firefox",
    "dev:prod": "buildc --deps-only -- wxt --mode production",
    "dev:prod:firefox": "buildc --deps-only -- pnpm -s dev:prod -b firefox",
    "build": "buildc --deps-only -- wxt build",
    "build:firefox": "pnpm -s build -b firefox",
    "zip": "buildc --deps-only -- wxt zip",
    "zip:firefox": "pnpm -s zip -b firefox",
    "postinstall": "wxt prepare",
    "test": "vitest --passWithNoTests"
  },
  "dependencies": {
    "@anime-skip/player": "workspace:*",
    "@webext-core/messaging": "^4.0.0"
  },
  "devDependencies": {
    "happy-dom": "^21.0.3",
    "sass": "^1.105.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  }
}
