{
  "name": "anime-skip-player",
  "type": "module",
  "scripts": {
    "check": "check && pnpm -r check",
    "build": "buildc all",
    "test": "pnpm -r test",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@aklinker1/buildc": "^1.1.7",
    "@aklinker1/check": "^2.4.0",
    "cspell": "^10.0.0",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "simple-git-hooks": "^2.13.1"
  },
  "simple-git-hooks": {
    "pre-commit": "./node_modules/.bin/nano-staged"
  },
  "nano-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@11.1.1",
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "@babel/core"
      ],
      "allowAny": [
        "node-fetch"
      ]
    }
  }
}
