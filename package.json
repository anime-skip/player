{
  "name": "anime-skip-player",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "check": "check && pnpm -r check",
    "build": "buildc all",
    "test": "pnpm -r test",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@aklinker1/buildc": "^1.1.7",
    "@aklinker1/check": "^2.4.0",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "simple-git-hooks": "^2.13.1"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "@babel/core"
      ],
      "allowAny": [
        "node-fetch"
      ]
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  }
}
